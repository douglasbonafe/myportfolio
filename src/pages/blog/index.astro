---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Hero from '../../components/Hero.astro';
import Pill from '../../components/Pill.astro';
import { formatDate, postUrl, translations, ui } from '../../i18n';

const all = await getCollection('blog');
// One card per post, in English; translations show up as links on the card.
const posts = all
	.filter((p) => p.data.lang === 'en')
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.map((post) => ({ post, others: translations(all, post).filter((v) => v.data.lang !== 'en') }));
---

<BaseLayout title="Blog | Douglas Bonafé" description="Notes on QA, test automation and AI engineering, each one backed by working code.">
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Blog"
				tagline="Notes on QA, test automation and AI engineering. Each post comes with code you can run."
				align="start"
			/>
			<ul class="posts">
				{
					posts.map(({ post, others }) => (
						<li class="post">
							<a class="main" href={postUrl(post)}>
								<time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate, 'en', 'short')}</time>
								<span class="title">{post.data.title}</span>
								<span class="description">{post.data.description}</span>
								<span class="tags">{post.data.tags.map((t) => <Pill>{t}</Pill>)}</span>
							</a>
							{others.length > 0 && (
								<p class="also">
									Also in{' '}
									{others.map((v, i) => (
										<>
											{i > 0 && ' · '}
											<a href={postUrl(v)} hreflang={v.data.lang} lang={v.data.lang}>{ui[v.data.lang].name}</a>
										</>
									))}
								</p>
							)}
						</li>
					))
				}
			</ul>
			<p class="older">
				Older notes live on
				<a href="https://painted-caribou-530.notion.site/IT-Blog-EN-2be843059b2d4e53ac3713cca77f86b6?pvs=4">Notion</a>.
			</p>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.posts {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.post {
		padding: 1.75rem;
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
		transition: box-shadow var(--theme-transition), border-color var(--theme-transition);
	}

	.post:hover,
	.post:focus-within {
		box-shadow: var(--shadow-md);
		border-color: var(--accent-regular);
	}

	.main {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		text-decoration: none;
		color: inherit;
	}

	.also {
		margin-top: 1rem;
		font-size: var(--text-sm);
		color: var(--gray-300);
	}

	.also a {
		color: var(--gray-100);
		text-underline-offset: 0.2em;
	}

	time {
		font-size: var(--text-sm);
		color: var(--gray-300);
	}

	.title {
		font-family: var(--font-brand);
		font-size: var(--text-xl);
		font-weight: 600;
		color: var(--gray-0);
		line-height: 1.2;
	}

	.description {
		color: var(--gray-200);
		max-width: 65ch;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.older {
		color: var(--gray-300);
	}

	@media (min-width: 50em) {
		.title {
			font-size: var(--text-2xl);
		}
	}
</style>
