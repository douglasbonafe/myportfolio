---
// The site is just the blog now. Send the root to the post list,
// respecting the base path (/ on Netlify, /myportfolio/ on GitHub Pages).
const target = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}blog/`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Douglas Bonafé | Blog</title>
		<meta http-equiv="refresh" content={`0; url=${target}`} />
		<link rel="canonical" href={target} />
	</head>
	<body>
		<a href={target}>Go to the blog</a>
	</body>
</html>
